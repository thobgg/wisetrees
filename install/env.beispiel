# Einstellungen für docker-compose.yml – als .env neben die Datei legen und anpassen.

# Benutzer, unter dem wisetrees läuft (nicht root). Dem gehört der Datenordner.
# Auf Linux: id -u und id -g; auf der Synology: Benutzer in der Systemsteuerung, meist 1026 und 100.
WISETREES_UID=1000
WISETREES_GID=1000

# Datenordner (Konten, Bäume, Bilder) und Port
WISETREES_DATA=./data
WISETREES_PORT=8099

TZ=Europe/Berlin

# Von welchen Adressen wisetrees die Köpfe eines Reverse Proxy (X-Forwarded-Proto, X-Forwarded-For) glaubt.
# Vorgabe: dieser Rechner und die internen Docker-Netze (Reverse Proxy auf derselben NAS).
WISETREES_PROXY=127.0.0.1,172.16.0.0/12
